NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: supplied local files in public/brand (svg, png or webp). Rebuild after changing.
NEXT_PUBLIC_BRAND_LOGO=/brand/cont-contabil.svg
NEXT_PUBLIC_BRAND_LOGO_LIGHT=/brand/cont-contabil-light.svg
NEXT_PUBLIC_BRAND_SYMBOL=/brand/cont-contabil-symbol.svg

# Server only: required for private username resolution and distributed login limits.
# Configure in the server environment. Never prefix this key with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
