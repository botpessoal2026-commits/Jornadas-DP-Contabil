# Obrigatórias: URL do projeto existente e chave pública publishable/anon.
# Nunca use service_role ou sb_secret_ em NEXT_PUBLIC_*.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Opcionais: arquivos locais em public/brand (SVG, PNG ou WebP). Refaça o build após alterar.
NEXT_PUBLIC_BRAND_LOGO=/brand/cont-contabil.svg
NEXT_PUBLIC_BRAND_LOGO_LIGHT=/brand/cont-contabil-light.svg
NEXT_PUBLIC_BRAND_SYMBOL=/brand/cont-contabil-symbol.svg

# Opcional: somente para login legado por nome de usuário.
# Cadastro/login por e-mail e persistência NÃO exigem chave privada.
# Configure somente no servidor. Nunca use o prefixo NEXT_PUBLIC_ nesta chave.
SUPABASE_SECRET_KEY=
